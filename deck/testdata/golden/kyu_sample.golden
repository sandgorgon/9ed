preamble  name=""           [0,143) "# sample.kyu — fixture for KyuSegmenter's golden test: a define, a"
define    name="count"      [143,155) "count := 5"
define    name="doubled"    [155,177) "doubled := count * 2"
assign    name=""           [177,195) "job.ctl = \"stop\""
bind      name=""           [195,220) "bind /srv/logs, /n/logs"
expr      name=""           [220,263) "jobs | where { |j| j.status == \"running\" }"
